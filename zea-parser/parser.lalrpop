use std::str::FromStr;
use zea_ipr::ast::ipr::*;
use zea_ipr::ast::{BinOp, UnOp, NodeId};
use crate::{IPRModuleItem, separate_module_items};

grammar<'ast>;

Comma0<T>: Vec<T> = {
    => vec![],
    <first:T> <items:("," <T>)*> => {
        let mut first = vec![first];
        first.extend(items);
        first
    }
};

Comma1<T>: Vec<T> = {
    <first:T> <rest:("," <T>)*>  => {
        let mut items = vec![first];
        items.extend(rest);
        items
    }
};

TTypedIdent:IPRTypedIdentifier = {
    <i:ExprIdent> ":" <t:TType> =>IPRTypedIdentifier::new(t, i)
};

pub Mod: IPRModule = {
    <name:ModName> <imports:ModImports?> <exports:ModExports?> <(global_vars, functions, struct_definitions, tagged_unions):ModSymbols> => {
        IPRModule {
            attributes: Default::default(),
            id: NodeId::sentinel(),
            name,
            imports: imports.unwrap_or(vec![]),
            exports: exports.unwrap_or(vec![]),
            global_vars,
            functions,
            struct_definitions
        }
 }
};

Attr: (String,Option<String>) = {
    "@" <key:ExprIdent> => (key,None),
    "@" <key:ExprIdent> "=" <value:ExprIdent> => (key,Some(value))
};

AttrList: Vec<(String,Option<String>)> = {
    Attr => vec![<>],
    <head:Attr> <tail:AttrList> => {
        let mut tail = tail;
        tail.push(head);
        tail
    }
}


CondBranch: IPRBranch = {
    "if" <condition:Expr> <true_case:Block> => {
        IPRBranch::if_block(condition, true_case.wrap_in_expression())
    },
    "if" <condition:Expr> <true_case:Block> "else" <false_case:Block> =>
        IPRBranch::if_else_block(condition, true_case.wrap_in_expression(), false_case.wrap_in_expression())
};

ModName: String = {
    "module" <name:ExprIdent> => name
};

ModImports: Vec<String> = {
    "imports" "{" <imps:Comma0<ExprIdent>> "}" => imps
};

ModExports: Vec<String> = {
    "exports"  "{" <imps:Comma0<ExprIdent>>  "}"=> imps
};
#[inline]
ModSymbols: (
Vec<IPRInitializationBlock>,
Vec<IPRFunction>,
Vec<IPRStructDataTypeDefinition>,
Vec<IPRTaggedUnionDataTypeDefinition>
) = {
    ModSymbolsHelper => separate_module_items(<>)
};

ModSymbolsHelper: Vec<IPRModuleItem> = {
    => vec![],
    <cur: Init> <rest:ModSymbolsHelper> => {
        let mut v = Vec::with_capacity(rest.len() + 1);
        v.push(IPRModuleItem::Init(cur));
        v.extend(rest);
        v
    },
    <cur: Func> <rest:ModSymbolsHelper> => {
        let mut v = Vec::with_capacity(rest.len() + 1);
        v.push(IPRModuleItem::Func(cur));
        v.extend(rest);
        v
        },

   // <cur: StructDef> <rest:ModSymbolsHelper> => {
   //             let mut v = rest;
   //                     v.push(IPRModuleItem::StructDef(cur));
   //                     v
   //         },

};

