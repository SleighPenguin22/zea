use std::str::FromStr;
use zea_ast::zea::hir_nodes::*;
use zea_ast::zea::{BinOp, UnOp, NodeId};
use crate::{HIRModuleItem, separate_module_items};

grammar<'ast>;

Comma0<T>: Vec<T> = {
    <items:(<T> ",")*> <last:T?> => {
        let mut items = items;
        items.extend(last);
        items
    }
};
Comma0NoTrail<T>: Vec<T> = {
    <first:T> <items:(","<T> )*> => {
        let mut first = vec![first];
        first.extend(items);
        first
    }
};

Comma1<T>: Vec<T> = {
    <first:T> <rest:("," <T>)*> ","? => {
        let mut items = vec![first];
        items.extend(rest);
        items
    }
};

TTypedIdent:HIRTypedIdentifier = {
    <i:ExprIdent> ":" <t:TType> =>HIRTypedIdentifier::new(t, i)
};

pub Mod: HIRModule = {
    <name:ModName> <imports:ModImports?> <exports:ModExports?> <(global_vars, functions, struct_definitions, tagged_unions):ModSymbols> => {
        HIRModule {
            id: NodeId::sentinel(),
            imports: imports.unwrap_or(vec![]),
            exports: exports.unwrap_or(vec![]),
            global_vars,
            functions,
            struct_definitions
        }
 }
};

CondBranch: HIRBranch = {
    "if" <condition:Expr> <true_case:Block> => {
        HIRBranch::if_block(condition, true_case.wrap_in_expression())
    },
    "if" <condition:Expr> <true_case:Block> "else" <false_case:Block> =>
        HIRBranch::if_else_block(condition, true_case.wrap_in_expression(), false_case.wrap_in_expression())
};

ModName: String = {
    "module" <name:ExprIdent> => name
};

ModImports: Vec<String> = {
    "imports" "{" <imps:Comma0<ExprIdent>> "}" => imps
};

ModExports: Vec<String> = {
    "exports"  "{" <imps:Comma0<ExprIdent>>  "}"=> imps
};
#[inline]
ModSymbols: (
Vec<HIRInitializationBlock>,
Vec<HIRFunction>,
Vec<HIRStructDataTypeDefinition>,
Vec<HIRTaggedUnionDataTypeDefinition>
) = {
    ModSymbolsHelper => separate_module_items(<>)
};

ModSymbolsHelper: Vec<HIRModuleItem> = {
    => vec![],
    <cur: Init> <rest:ModSymbolsHelper> => {
        let mut v = rest;
        v.push(HIRModuleItem::Init(cur));
        v
    },
    <cur: Func> <rest:ModSymbolsHelper> => {
            let mut v = rest;
                    v.push(HIRModuleItem::Func(cur));
                    v
        },

   // <cur: StructDef> <rest:ModSymbolsHelper> => {
   //             let mut v = rest;
   //                     v.push(HIRModuleItem::StructDef(cur));
   //                     v
   //         },

};

